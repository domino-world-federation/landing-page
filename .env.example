# Menyambungkan situs ke API backoffice.
#
# SELAMA KOSONG, situs menyajikan data mock dari `app/lib/api/mock/` — itu
# sakelarnya, dan `useMock()` di `app/lib/api/client.ts` yang membacanya. Jadi
# klon baru tetap jalan tanpa backend, dan tidak ada yang perlu mematikan apa
# pun untuk mengembangkan halaman.
#
# Lokal  : http://127.0.0.1:8000/api/v1   (jalankan `composer dev` di ../backend-cms)
# Produksi: https://cms.dwf-domino.org/api/v1
#
# Domain situs ini HARUS terdaftar di `CORS_ALLOWED_ORIGINS` sisi backend, atau
# setiap permintaan dari browser ditolak — lihat ../backend-cms/docs/API.md.
NUXT_PUBLIC_API_BASE_URL=

# Origin publik situs ini, tanpa garis miring di ujung.
#
# Dipakai `<link rel="canonical">` dan URL absolut di /sitemap.xml. Kosong
# berarti memakai origin permintaan yang masuk — benar di lokal dan benar di
# produksi juga, SAMPAI aplikasinya duduk di belakang proxy yang tidak
# meneruskan host aslinya. Saat itu tiap canonical mengumumkan alamat internal
# yang tidak bisa dijangkau mesin pencari mana pun.
#
# Produksi: https://dwf-domino.org
NUXT_PUBLIC_SITE_URL=
